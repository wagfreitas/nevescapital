# Fastfile de exemplo para iOS
# Copie este arquivo para ios/fastlane/Fastfile e configure conforme necessário

default_platform(:ios)

platform :ios do
  # Configurações gerais
  before_all do
    # Verificar que Flutter está instalado
    ENV["FLUTTER_ROOT"] = `which flutter | xargs dirname | xargs dirname`.strip
  end

  desc "📦 Build e upload para TestFlight"
  lane :beta do
    # 1. Limpar projeto
    sh("cd .. && flutter clean")
    
    # 2. Instalar dependências
    sh("cd .. && flutter pub get")
    
    # 3. Atualizar pods
    cocoapods(
      podfile: "./Podfile",
      try_repo_update_on_error: true
    )
    
    # 4. Incrementar build number automaticamente
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || number_of_commits
    )
    
    # 5. Build Flutter (sem assinatura - Xcode faz depois)
    sh("cd .. && flutter build ios --release --no-codesign")
    
    # 6. Build e archive no Xcode
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "PagPag.ipa",
      include_bitcode: false,
      include_symbols: true
    )
    
    # 7. Upload para TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      groups: ["Internal Testers"], # Grupos de teste opcionais
      changelog: ENV["CHANGELOG"] || "Nova versão de teste"
    )
    
    # 8. Notificação (opcional)
    # slack(
    #   message: "✅ Build #{$BUILD_NUMBER} enviado para TestFlight!",
    #   success: true
    # )
    
    UI.success("✅ Build #{$BUILD_NUMBER} enviado para TestFlight com sucesso!")
  end

  desc "🚀 Build e upload para App Store (produção)"
  lane :release do
    # Verificar que versão foi especificada
    unless ENV["VERSION"]
      UI.user_error!("❌ VERSION não especificada. Use: VERSION=1.0.1 fastlane release")
    end
    
    # 1. Atualizar versão
    increment_version_number(
      version_number: ENV["VERSION"],
      xcodeproj: "Runner.xcodeproj"
    )
    
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || number_of_commits
    )
    
    # 2. Limpar projeto
    sh("cd .. && flutter clean")
    sh("cd .. && flutter pub get")
    
    # 3. Atualizar pods
    cocoapods(
      podfile: "./Podfile",
      try_repo_update_on_error: true
    )
    
    # 4. Build Flutter
    sh("cd .. && flutter build ios --release --no-codesign")
    
    # 5. Build e archive
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "PagPag.ipa"
    )
    
    # 6. Upload para App Store Connect
    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: ENV["SUBMIT"] == "true",
      automatic_release: false,
      force: false,
      submission_included: ENV["SUBMIT"] == "true",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots"
    )
    
    UI.success("✅ Versão #{ENV["VERSION"]} enviada para App Store!")
  end

  desc "🔨 Apenas build (sem upload)"
  lane :build do
    sh("cd .. && flutter clean")
    sh("cd .. && flutter pub get")
    
    cocoapods
    
    sh("cd .. && flutter build ios --release --no-codesign")
    
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "./build"
    )
    
    UI.success("✅ Build criado em ./build/PagPag.ipa")
  end

  desc "📸 Gerar screenshots automaticamente"
  lane :screenshots do
    # Requer Snapshot (fastlane snapshot)
    capture_screenshots(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      devices: [
        "iPhone 15 Pro Max",
        "iPhone 15 Pro",
        "iPad Pro (12.9-inch) (6th generation)"
      ],
      output_directory: "./fastlane/screenshots",
      skip_open_summary: false
    )
    
    # Upload screenshots
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      force: true
    )
    
    UI.success("✅ Screenshots gerados e enviados!")
  end

  desc "🔐 Setup inicial (Match para certificados)"
  lane :setup do
    match(
      type: "appstore",
      app_identifier: "com.nevescapital.pagpag",
      readonly: false,
      force_for_new_devices: false
    )
    
    UI.success("✅ Certificados configurados!")
  end

  desc "🧹 Limpar builds e caches"
  lane :clean do
    sh("cd .. && flutter clean")
    sh("cd .. && rm -rf build/")
    sh("cd .. && rm -rf ios/build/")
    sh("cd .. && rm -rf ios/Pods/")
    sh("cd .. && rm -rf ios/Podfile.lock")
    sh("cd .. && rm -rf ~/Library/Developer/Xcode/DerivedData")
    
    UI.success("✅ Projeto limpo!")
  end

  # Lanes privadas (auxiliares)
  private_lane :ensure_git_status_clean do
    ensure_git_status_clean(
      show_uncommitted_changes: true,
      show_diff: true
    )
  end
end

# Tratamento de erros
error do |lane, exception|
  UI.error("❌ Erro na lane #{lane}: #{exception.message}")
  
  # Notificação de erro (opcional)
  # slack(
  #   message: "❌ Erro no build: #{exception.message}",
  #   success: false
  # )
end

# Após cada lane bem-sucedida
after_all do |lane|
  UI.success("✅ Lane #{lane} finalizada com sucesso!")
end
