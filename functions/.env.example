# ============================================
# CONFIGURAÇÃO DO BACKEND NESTJS
# ============================================

# Porta do servidor
PORT=8080

# Ambiente
NODE_ENV=development

# Firebase Project ID (mesmo projeto do Firestore onde grava otp_codes)
GOOGLE_CLOUD_PROJECT=apppagpag

# === Autenticação Firebase (escolha UMA opção) ===
#
# Opção A (melhor): Service Account Key JSON
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
#
# Opção B (recomendado quando SA key é bloqueada): Firebase CI Token
# Gere com: npx firebase login:ci
# FIREBASE_CI_TOKEN=1//0h...seu_token_aqui
#
# Opção C (evite — expira por RAPT): ADC JSON de usuário
# GOOGLE_CREDENTIALS_JSON={"type":"authorized_user",...}

# CORS - Permitir origens (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*

# API Key (mesma que você usa no Flutter)
API_KEY=neves-capital-api-key-prod-2024
