# ============================================
# CONFIGURAÇÃO DO BACKEND NESTJS
# ============================================

# Porta do servidor
PORT=8080

# Ambiente
NODE_ENV=development

# Firebase Project ID (mesmo projeto do Firestore onde grava otp_codes)
GOOGLE_CLOUD_PROJECT=apppagpag

# === Autenticação Firebase (escolha UMA opção) ===
#
# Opção A (melhor): Service Account Key JSON
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
#
# Opção B (recomendado quando SA key é bloqueada): Firebase CI Token
# Gere com: npx firebase login:ci
# FIREBASE_CI_TOKEN=1//0h...seu_token_aqui
#
# Opção C (evite — expira por RAPT): ADC JSON de usuário
# GOOGLE_CREDENTIALS_JSON={"type":"authorized_user",...}

# CORS - Permitir origens (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*

# API Key (mesma que você usa no Flutter)
API_KEY=neves-capital-api-key-prod-2024

# ============================================
# EFÍ PAY (PIX)
# ============================================
# Ambiente: 'homologacao' (sandbox) ou 'producao'
EFI_AMBIENTE=homologacao

# Credenciais da aplicação (Efí → API → Aplicações → sua app)
EFI_CLIENT_ID=Client_Id_xxxxxxxxxxxxxxx
EFI_CLIENT_SECRET=Client_Secret_xxxxxxxxxxxxxxx

# Certificado .p12 (mTLS obrigatório)
# Opção A (produção/Railway): conteúdo do .p12 em base64
#   Gere com: base64 -i certificado.p12 | tr -d '\n'
# EFI_CERT_BASE64=MIIJ...base64...==
#
# Opção B (dev local): caminho para o arquivo .p12
# EFI_CERT_PATH=./certs/homologacao.p12

# Passphrase do certificado (normalmente vazio na Efí)
EFI_CERT_PASSPHRASE=

# Chave PIX do pagador (conta Efí que envia o PIX)
# OBRIGATÓRIA para PIX-out. Precisa ter webhook registrado.
EFI_PAGADOR_CHAVE=sua-chave-pix-aqui

# URL pública do webhook receiver (para receber confirmações PIX)
# Em dev: use ngrok ou similar
# Em prod: https://seu-dominio.com/api/webhooks/efi/pix
# EFI_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/efi/pix
