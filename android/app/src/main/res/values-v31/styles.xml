<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    Android 12+ usa a Splash Screen API do sistema: o ícone do app aparece
    dentro de um círculo. Para "esconder" o círculo, usamos a mesma cor de fundo
    do app (#023E25) no windowSplashScreenIconBackgroundColor.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#023E25</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#023E25</item>
        <!-- Opcional: ícone customizado. Coloque em res/drawable/ (ex.: splash_icon.png) e descomente:
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        -->
    </style>
</resources>
