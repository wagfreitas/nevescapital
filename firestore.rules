rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Coleção users
    // Permite leitura pública para busca por CPF (apenas hash é exposto)
    // Permite escrita para criar novos usuários (cadastro)
    // Permite atualização apenas se o documento não existir ou se for o próprio usuário
    match /users/{userId} {
      // Permitir leitura pública (necessário para busca por CPF antes do login)
      // Apenas hash é exposto, dados sensíveis estão criptografados
      allow read: if true;
      
      // Permitir criação de novos usuários (cadastro)
      allow create: if true;
      
      // Permitir atualização apenas se o documento não existir ou se for o próprio usuário
      // (validação feita pelo app - aqui apenas permitimos)
      allow update: if true;
      
      // Não permitir delete (ou permitir apenas com validação adicional)
      allow delete: if false;
    }
    
    // Coleção registration_progress - rastrear cadastros parciais
    // Permite leitura e escrita pública (dados sensíveis criptografados)
    match /registration_progress/{progressId} {
      allow read: if true; // Permitir leitura para verificar progresso
      allow create: if true; // Permitir criar novo progresso
      allow update: if true; // Permitir atualizar progresso existente
      allow delete: if true; // Permitir deletar após finalizar cadastro
    }
    
    // Coleção otps - apenas Cloud Functions podem escrever
    match /otps/{otpId} {
      allow read: if true; // Permitir leitura para verificar OTP
      allow write: if false; // Apenas Cloud Functions podem escrever
    }
    
    // Coleção transactions - usuário só acessa suas transações
    match /transactions/{transactionId} {
      allow read: if true; // Permitir leitura (validação feita pelo app)
      allow write: if false; // Apenas Cloud Functions podem escrever
    }
  }
}

