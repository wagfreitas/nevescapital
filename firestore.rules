rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Coleção users
    match /users/{userId} {
      // Permitir criação durante o cadastro inicial (sem autenticação)
      // Isso é necessário porque o usuário ainda não está autenticado no Firebase Auth
      // durante o processo de cadastro
      allow create: if true;
      
      // Permitir atualização durante o cadastro inicial (sem autenticação)
      // Necessário para atualizar dados após criação inicial
      allow update: if true;
      
      // Leitura: permitir sem autenticação para permitir busca por hash (cpfHash, emailHash, phoneHash)
      // Esses hashes são usados para buscar usuários sem precisar de autenticação Firebase Auth
      // NOTA: Dados sensíveis (CPF, email, telefone) estão criptografados, então é seguro
      // NOTA: Admin SDK (usado no backend) bypassa estas regras automaticamente
      allow read: if true;
      
      // Exclusão apenas pelo próprio usuário (após autenticação)
      allow delete: if isOwner(userId);
    }
    
    // Permitir queries na collection users para o backend (Admin SDK bypassa, mas adicionamos comentário)
    // O Admin SDK sempre bypassa as regras, então estas regras só se aplicam a clientes
    // Se o erro persistir, verifique as permissões IAM do serviço Cloud Run
    
    // Coleção registration_progress
    // Permitir escrita sem autenticação durante o cadastro inicial
    // Os dados são criptografados e identificados por hash do CPF
    // Leitura também permitida sem auth para permitir retomada do cadastro
    match /registration_progress/{progressId} {
      allow read, write: if true; // Permitir durante cadastro (dados criptografados)
    }
    
    // Coleção otps - Apenas Cloud Functions (Admin SDK)
    match /otps/{otpId} {
      allow read, write: if false;
    }
    
    // Coleção transactions
    match /transactions/{transactionId} {
      // Usuário só lê se for dono (assumindo campo userId no documento)
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    
    // Subcollection de vendas do usuário
    // Estrutura: users/{userId}/sales/{saleId}
    // Permite leitura/escrita na subcollection (app identifica usuário por CPF/doc id no código)
    match /users/{userId}/sales/{saleId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}

