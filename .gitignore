**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/docs/

# Symbolication related
app.*.symbols
*.dSYM.zip
*.dSYM

# iOS build artifacts
*.ipa
Runner.app.dSYM.zip

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.env.local

# Segurança - variáveis de ambiente
.env
*.env
!.env.example

# Android - Keystore e configurações de assinatura
android/key.properties
*.jks
*.keystore
upload-keystore.jks

# Scripts de desenvolvimento (não versionados)
*.sh
!ios/Flutter/flutter_export_environment.sh
scripts/

# Dependências Node (raiz) — nunca versionar
node_modules/

# Agent-OS standards (gerados por ferramentas de IA)
