rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Permite upload de documentos KYC
    match /users/{userId}/kyc/{document} {
      // Permitir criação durante o cadastro inicial (sem autenticação)
      // Isso é necessário porque o usuário ainda não está autenticado no Firebase Auth
      // durante o processo de cadastro
      allow create: if request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
      
      // Leitura apenas para usuário autenticado dono dos documentos
      allow read: if isOwner(userId);
      
      // Atualização apenas para usuário autenticado dono dos documentos
      allow update: if isOwner(userId)
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
      
      // Exclusão apenas para usuário autenticado
      allow delete: if isOwner(userId);
    }
    
    // Bloquear todo o resto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
